# Ship Recognition Platform - Environment Configuration
# Copy to .env and adjust values as needed

APP_NAME=ShipRecognition
APP_ENV=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=3025

# Database (SQLite)
# DATABASE_URL=sqlite:///./schiffs-scraper.db

# Paths (defaults are relative to project root)
# DOWNLOAD_DIR=./downloads
# UPLOAD_DIR=./uploads
# AUGMENTED_DIR=./augmented
# MODEL_DIR=./models/ship_classifier
# DATA_DIR=./data
# LOG_DIR=./logs

# ML Model (ship type / Bauart classifier — ViT)
DEFAULT_MODEL_NAME=dima806/10_ship_types_image_detection

# Visual similarity / specific-ship recognition (DINOv2 embeddings).
# Use facebook/dinov2-small on CPU-only setups; -base/-large benefit from a GPU.
EMBEDDING_MODEL=facebook/dinov2-base
SIMILARITY_THRESHOLD=0.6   # open-set: below this -> "no confident match"
SIMILARITY_MARGIN=0.05     # top1 - top2 must exceed this to be "confident"
# EMBEDDING_AUTO_INDEX=false   # add each scraped image to the gallery (needs GPU)

# ArcFace re-id fine-tuning (learns ship-specific projection on DINOv2 features)
REID_MIN_IMAGES=4          # ships need >= this many images to become a class
REID_EMBED_DIM=256
REID_EPOCHS=30

# VPN — NordVPN SOCKS5 proxy
VPN_ENABLED=true
VPN_API_KEY=  # NordVPN Access Token (aus https://my.nordaccount.com)
# SOCKS5-Exit-Land fuer den Scraper-Traffic. NordVPN bietet SOCKS5 nur in
# Netherlands, Sweden, United States. (Deutschland hat KEINEN SOCKS5-Proxy.)
VPN_PROXY_COUNTRY=Netherlands

# CORS (comma-separated origins)
# CORS_ORIGINS=["http://localhost:3025","http://localhost:5173"]

# Upload
MAX_UPLOAD_SIZE_MB=25

# Security
SECRET_KEY=change_me_in_production
